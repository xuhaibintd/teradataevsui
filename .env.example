EVSUI_ENVIRONMENT=development
WEB_CONCURRENCY=1

# Leave both empty for the one-time browser setup. Set both only for unattended bootstrap.
EVSUI_BOOTSTRAP_ADMIN=
EVSUI_BOOTSTRAP_PASSWORD=

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVSUI_CREDENTIAL_KEY=

EVSUI_EXTERNAL_API_ENABLED=false
EVSUI_API_TOKEN=
EVSUI_SESSION_TTL_SECONDS=28800
EVSUI_MAX_UPLOAD_BYTES=104857600
EVSUI_ARTIFACT_RETENTION_DAYS=30
EVSUI_ARTIFACT_CLEANUP_ENABLED=false
EVSUI_JOB_STALE_SECONDS=900
EVS_VECTORSTORE_READY_TIMEOUT_SECONDS=7200
EVS_VECTORSTORE_READY_POLL_SECONDS=5
